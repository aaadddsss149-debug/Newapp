# Deps & build output (rebuilt inside the image)
**/node_modules
**/dist
backend/data
*.sqlite
*.sqlite-*

# Secrets & local files (env is injected via docker compose env_file)
.env
.env.*
.logs
*.log

# VCS / CI / docs not needed at runtime
.git
.github
.gitignore
docs
README*.md
CONTRIBUTING.md

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore
