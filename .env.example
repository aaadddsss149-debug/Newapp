# =========================================================
#  TON Mini App Starter — environment (copy to .env)
#  NEVER commit the real .env. Only this .env.example is committed.
# =========================================================

# ---- Server ----
NODE_ENV=development
PORT=8080
# Public HTTPS origin of the app (ngrok URL in dev, your subdomain in prod)
PUBLIC_URL=https://ton-starter.mattpixel.dev
# Comma-separated allowed CORS origins (optional; empty reflects request origin)
CORS_ORIGINS=

# ---- Telegram ----
# Bot token from @BotFather. SERVER ONLY. Never expose to the client.
BOT_TOKEN=123456:REPLACE_ME
# Max age (seconds) of accepted Telegram initData (replay protection)
INITDATA_MAX_AGE=3600
# Long-poll the bot for /start + payment notifications (true/false).
# Set "false" in production if you serve the bot via a webhook instead.
BOT_POLLING=true

# ---- Admin ----
# Telegram user IDs allowed into the admin panel from inside Telegram (comma-separated)
ADMIN_TELEGRAM_IDS=
# Password for the browser admin at /admin. Use a LONG random string.
# Leave empty to disable browser login entirely.
ADMIN_PASSWORD=
# Secret used to sign admin session cookies (min 16 chars). Generate a random one.
# `./manage.sh config` will auto-generate this if left as the placeholder.
SESSION_SECRET=change_me_to_a_long_random_secret
# Admin browser session lifetime (hours)
ADMIN_SESSION_TTL_HOURS=12

# ---- TON ----
TON_NETWORK=mainnet
# Optional explicit RPC endpoint (leave commented to use the toncenter default for the network)
# TON_API_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
# toncenter API key (recommended — raises rate limits). Get one from @tonapibot.
TON_API_KEY=
# Merchant wallet that receives payments
MERCHANT_ADDRESS=EQ_REPLACE_ME
# USDT jetton master (mainnet default below)
JETTON_MASTER_ADDRESS=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
JETTON_DECIMALS=6

# ---- Payment watcher ----
WATCH_INTERVAL_MS=3000
WATCH_MAX_BACKOFF_MS=60000
INVOICE_TTL_MINUTES=30

# ---- Storage ----
DB_PATH=./data/app.sqlite

# ---- Frontend (Vite: variables MUST be prefixed with VITE_) ----
VITE_API_BASE=/api
VITE_TON_NETWORK=mainnet
VITE_TONCONNECT_MANIFEST_URL=https://ton-starter.mattpixel.dev/tonconnect-manifest.json
